# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=http://localhost:3000

# Set to 'true' to proxy requests to real Spring Boot microservices (requires Docker)
USE_REAL_SERVICES=false
TRANSACTION_SERVICE_URL=http://transaction-service:8081
AUDIT_SERVICE_URL=http://audit-service:8082
ACCOUNT_SERVICE_URL=http://account-service:8083
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DATABASE_URL=jdbc:postgresql://postgres:5432/banking
