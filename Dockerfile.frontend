# Dockerfile for Frontend & Gateway (React + Express)
# Multi-stage build for efficiency

# Stage 1: Build the React application
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
# Use cache mount for faster installs
RUN --mount=type=cache,target=/root/.npm npm install
COPY . .
RUN npm run build

# Stage 2: Production environment
FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/server.ts ./
COPY --from=builder /app/tsconfig.json ./

# Install only production dependencies using cache
RUN --mount=type=cache,target=/root/.npm npm install --only=production

# Expose the gateway port
EXPOSE 3000

# Start the gateway server using the local tsx
CMD ["npx", "tsx", "server.ts"]
